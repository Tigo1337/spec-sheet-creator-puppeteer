# ---------------------------------------------------------------------------
# Doculoom environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# In Replit, set these as Secrets instead of using a .env file.
# `_DEV` variants are used when NODE_ENV !== "production".
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (Neon / Postgres connection string)
DATABASE_URL=

# Clerk authentication (server)
CLERK_SECRET_KEY=
CLERK_SECRET_KEY_DEV=

# Stripe (server)
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_DEV=

# Google Gemini AI
GEMINI_API_KEY=

# Google Cloud Storage service-account credentials (full JSON, single line)
GCLOUD_KEY_JSON=

# External PDF rendering worker base URL
PDF_WORKER_URL=

# Error monitoring (server)
SENTRY_DSN=
# Sentry sampling (0.0–1.0). Defaults to 0.1 (10%) when unset.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Admin overrides
ADMIN_USER_ID=
ADMIN_EMAIL=

# CORS — extra browser origins allowed to call the API (comma-separated).
# Same-origin requests and the VITE_APP_BASE_URL origin are always allowed.
# Leave blank unless a separate frontend domain calls this API.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Client-side (Vite) — exposed in the browser bundle. Use PUBLISHABLE keys ONLY.
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY_DEV=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_APP_BASE_URL=
